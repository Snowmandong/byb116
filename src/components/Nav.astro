---
// 获取当前页面的 URL 路径（例如 "/"、"/about.html"、"/pricing.html"）
const pathname = Astro.url.pathname;

// 判断是否为首页
const isHome = pathname === '/' || pathname === '/index.html';
---

<div class="header">
  <div class="container clearfix">
    <div class="sp_nav">
      <span class="sp_nav1"></span> <span class="sp_nav2"></span>
      <span class="sp_nav3"></span>
    </div>
    <a href="javascript:;" class="menu-btn"><span></span></a>
    <div class="logo img-center">
      <a href="/">
        <img
          src="/static/picture/1752800976667210.png"
          alt="网络建站公司"
          title="网络建站公司"
        />
      </a>
    </div>
    <ul class="nav">
      <li class={isHome ? 'active' : 'dropdown'}>
        <a href="/" rel="nofollow">首页</a>
      </li>

      <li class={pathname.includes('pricing') ? 'dropdown active' : 'dropdown'}>
        <i class="arr"></i><a href="/pricing.html">网站建设</a>
      </li>

      <li class={pathname.includes('seo') ? 'dropdown active' : 'dropdown'}>
        <a href="/seo.html">优化排名</a>
      </li>

      <li class={pathname.includes('case') ? 'dropdown active' : 'dropdown'}>
        <i class="arr"></i><a href="/case.html">客户案例</a>
      </li>

      <li class={pathname.includes('news') ? 'dropdown active' : 'dropdown'}>
        <i class="arr"></i><a href="/news.html">新闻资讯</a>
      </li>

      <li class={pathname.includes('about') ? 'dropdown active' : 'dropdown'}>
        <a href="/about.html">关于我们</a>
      </li>

      <li class={pathname.includes('content') || pathname.includes('contact') ? 'dropdown active' : 'dropdown'}>
        <a href="/content.html">联系我们</a>
      </li>
    </ul>
  </div>
</div>

<div class="sp_nav-box">
  <div class="container">
    <div class="inner">
      <div class="logo img-center wow slideInDown">
        <img
          src="/static/picture/1752738910477562.png"
          alt="网络建站公司"
          height="100"
        />
      </div>
      <ul class="wow slideInDown">
        <li><a href="/" rel="nofollow">返回首页</a></li>
        <li><a href="/pricing.html">网站建设</a></li>
        <li><a href="/seo.html">优化排名</a></li>
        <li><a href="/case.html">客户案例</a></li>
        <li><a href="/news.html">新闻资讯</a></li>
        <li><a href="/about.html">关于我们</a></li>
        <li><a href="/content.html">联系我们</a></li>
      </ul>
      <div class="in-ready wow slideInUp">
        <div class="container">
          <h4>我们已经准备好了,你呢？</h4>
          <div class="btn">
            <a href="tel:19903970011">获取报价：19903970011</a>
          </div>
          <p>2026我们与您携手共赢，为您的企业形象保驾护航！</p>
        </div>
      </div>
    </div>
  </div>
</div>