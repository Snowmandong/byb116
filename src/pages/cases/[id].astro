---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const caseList = [
    { id: '1', title: '案例展示一', img: '/static/cases/1/2026111612.jpg' },
    { id: '2', title: '案例展示二', img: '/static/cases/2/2026111622.jpg' },
    { id: '3', title: '案例展示三', img: '/static/cases/3/2026111632.jpg' },
    { id: '4', title: '案例展示四', img: '/static/cases/4/2026111642.jpg' },
    { id: '5', title: '案例展示五', img: '/static/cases/5/2026111652.jpg' },
    { id: '6', title: '案例展示六', img: '/static/cases/6/2026111662.jpg' },
    { id: '7', title: '案例展示七', img: '/static/cases/7/2026111672.jpg' },
    { id: '8', title: '案例展示八', img: '/static/cases/8/2026111682.jpg' },
  ];

  return caseList.map((item) => ({
    params: { id: item.id },
    props: { caseItem: item },
  }));
}

const { caseItem } = Astro.props;
---

<BaseLayout
  title={`${caseItem.title}-客户案例-网络建站公司`}
  keywords="客户案例,网站建设案例,网络公司网站,建站公司网"
  description={`${caseItem.title}详情展示-河南买余电子科技有限公司`}
>
  <div
    class="banner-sub"
    style="background-image: url(/static/images/case.jpg)"
  >
  </div>

  <!--当前位置-->
  <div class="position">
    <div class="container">
      <i></i>当前位置：<a href="/">首页</a> &gt;&gt;
      <a href="/case.html">客户案例</a> &gt;&gt;
      <span>{caseItem.title}</span>
    </div>
  </div>

  <!--案例长图居中展示区-->
  <div class="section">
    <div class="container">
      <div class="section-title">
        <strong>{caseItem.title}</strong>
      </div>
      <div class="case-detail-box">
        <img
          src={caseItem.img}
          alt={caseItem.title}
          class="case-detail-img"
        />
      </div>
      <div style="text-align: center; margin-top: 40px;">
        <a href="/case.html" class="more-big-2" style="display: inline-block; padding: 10px 35px;">返回案例列表</a>
      </div>
    </div>
  </div>

  <div class="section in-ready" style="background: #f5f5f5">
    <div class="container">
      <h4>我们已经准备好了,你呢？</h4>
      <div class="btn">
        <a
          href="tel:19903970011"
          style="
            border-left: 25px solid #f5f5f5;
            border-right: 25px solid #f5f5f5;
          "
          >获取报价：19903970011</a
        >
      </div>
      <p>2026我们与您携手共赢，为您的企业形象保驾护航！</p>
    </div>
  </div>

  <div class="section">
    <div class="container">
      <ul class="in-partone clearfix">
        <li class="wow bounceInLeft">
          <div class="wrap">
            <h4>继续在老套路中化作尘埃</h4>
            <a
              href="http://wpa.qq.com/msgrd?v=3&uin=250801208&site=qq&menu=yes"
              rel="nofollow"
              target="_blank"
              >评估旧网站</a
            >
          </div>
        </li>
        <li class="wow bounceInRight">
          <div class="wrap">
            <h4>还是厚积薄发重新崛起</h4>
            <a
              href="http://wpa.qq.com/msgrd?v=3&uin=250801208&site=qq&menu=yes"
              rel="nofollow"
              target="_blank"
              >启动新征程</a
            >
          </div>
        </li>
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .case-detail-box {
    width: 100%;
    text-align: center;
    background-color: #ffffff;
    padding: 20px;
    box-sizing: border-box;
    box-shadow: 0 2px 15px rgba(0, 0, 0, 0.06);
    border-radius: 4px;
  }
  .case-detail-img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }
  @media (max-width: 767px) {
    .case-detail-box {
      padding: 10px;
    }
  }
</style>