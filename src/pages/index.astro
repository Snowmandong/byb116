---
import BaseLayout from '../layouts/BaseLayout.astro';
import { newsList } from '../data/newsData.js';

// 自动按分类筛选首页展示的新闻列表
const gongsiNews = newsList.filter((item) => item.category === '公司新闻').slice(0, 8);
