---
import BaseLayout from '../layouts/BaseLayout.astro';
import { newsList } from '../data/newsData.js';

// 左侧推荐栏：自动取前 4 篇“建站知识”
const sideRecommend = newsList.filter((item) => item.category === '建站知识').slice(0, 4);

// 右侧主列表：自动展示前 10 篇最新新闻
const mainNewsList = newsList.slice(0, 10);
---

<BaseLayout
  title="新闻资讯-网络建站公司"
  keywords="网络公司网站,建站公司网"
  description="网络建站公司"
>
  <div
    class="banner-sub"
    style="background-image: url(/static/images/news.jpg)"
  >
  </div>

  <!--当前位置-->
  <div class="position">
    <div class="container">
      <i></i>当前位置：<a href="/">首页</a> &gt;&gt; <a href="/news.html">新闻资讯</a>
    </div>
  </div>

  <div class="section-sub" style="background-color: #f8f8f8">
    <div class="container clearfix">
      <!-- 左侧推荐栏（自动循环渲染） -->
      <ul class="v-lanmu">
        {sideRecommend.map((item) => (
          <li>
            <a href={`/news/${item.id}.html`}>
              <strong>{item.title}</strong>{item.category}
            </a>
          </li>
        ))}
      </ul>

      <div class="v-main">
        <ul class="h-lanmu">
          <li><a href="/news.html">公司新闻</a></li>
          <li><a href="/news.html">行业新闻</a></li>
          <li><a href="/news.html">建站知识</a></li>
        </ul>

        <!-- 右侧新闻主列表（自动循环渲染） -->
        <ul class="list-3">
          {mainNewsList.map((item) => (
            <li>
              <a href={`/news/${item.id}.html`}>
                <div class="img-center">
                  <img
                    src={item.img}
                    alt={item.title}
                  />
                </div>
                <div class="text">
                  <h4>{item.title}</h4>
                  <p>{item.summary}</p>
                  <span>日期：{item.date}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>

        <div class="pagebar">
          <div class="pagination">
            <a class="page-item page-link hidden-sm" href="/news.html" title="首页">首页</a>
            <a class="page-item page-link st" href="javascript:;" title="上一页">&lt;&lt;</a>
            <a href="/news.html" class="page-num page-num-current">1</a>
            <a class="page-item page-link" href="javascript:;" title="当前页/总页数">1/1</a>
            <a class="page-item page-link st" href="javascript:;" title="下一页">&gt;&gt;</a>
            <a class="page-item page-link hidden-sm" href="/news.html" title="尾页">尾页</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>